# Copy to .env — never commit .env to git

# ── Domains ──────────────────────────────────────────────────────────────────
# webai-2api panel + raw API (you can call this directly too)
GEMINI_APP_DOMAIN=gemini-app.chatflow.tech

# Watermark-stripped API endpoint (call THIS from your Shopify app)
WATERMARK_DOMAIN=gemini.chatflow.tech

# ── WebAI2API auth key ────────────────────────────────────────────────────────
# Set this in data/config.yaml under server.auth AFTER first deploy
# Also paste the same value here so the proxy can forward auth to upstream
WEBAI_API_KEY=sk-change-me-to-your-secure-key
